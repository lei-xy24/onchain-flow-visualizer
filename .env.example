# 只配置在定时任务或 CI 的 Secret 中，不要写入 static-site 或提交真实密钥。
DEEPSEEK_API_KEY=

# 可选：覆盖 social-radar.config.json 中的默认模型。
DEEPSEEK_MODEL=deepseek-v4-pro

# 可选：使用兼容代理时覆盖；默认 https://api.deepseek.com。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# X 只读 App Bearer Token，用于每周增量读取人物公开动态。
X_BEARER_TOKEN=

# 可选：默认 https://api.x.com。
X_API_BASE_URL=https://api.x.com

# 特朗普公开动态归档；当前读取 API 不需要密钥。
TRUMP_FM_BASE_URL=https://trump.fm
TRUMP_FM_STATE_FILE=data/social-input/trump-fm-state.json

# 可选：真实社交采集器在运行前写入的输入文件。
SOCIAL_INPUT_FILE=data/social-input/latest.json

# 可选：保存每个人物最近一条动态 id，避免重复读取。
X_STATE_FILE=data/social-input/x-state.json

# 可选：市场/链上采集器在运行前写入的输入文件。
MARKET_INPUT_FILE=data/market-input/latest.json

# 可选：改用后端团队提供的主题市场 JSON。若接口需要鉴权，Token 只放服务器环境变量。
MARKET_INPUT_URL=
MARKET_INPUT_BEARER_TOKEN=

# 可选：CoinGecko Demo Key；留空时使用无需鉴权的公共接口。
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_REQUEST_INTERVAL_MS=7000

# 服务器显式设为 1 后，成功快照才会提交并推送到 GitHub Pages 使用的 main。
# 本地和 CI 默认不设置，避免意外修改远程仓库。
RADAR_GITHUB_PUBLISH=0
RADAR_GIT_REMOTE=origin
RADAR_PUBLISH_BRANCH=main
RADAR_GIT_AUTHOR_NAME=onchain-radar-bot
RADAR_GIT_AUTHOR_EMAIL=onchain-radar-bot@users.noreply.github.com
