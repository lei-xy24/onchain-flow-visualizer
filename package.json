{
  "name": "onchain-flow-visualizer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "radar:snapshot": "node scripts/generate-social-radar-snapshot.mjs",
    "radar:demo": "node scripts/generate-social-radar-snapshot.mjs --demo",
    "radar:collect": "node scripts/collect-social-posts.mjs",
    "radar:collect:trump": "node scripts/collect-trump-posts.mjs",
    "radar:collect:x": "node scripts/collect-x-posts.mjs",
    "radar:market": "node scripts/refresh-market-input.mjs",
    "radar:event-candidates": "node scripts/generate-event-impact-candidates.mjs",
    "radar:event-market": "node scripts/refresh-event-market-input.mjs",
    "radar:cycle": "node scripts/run-social-radar-cycle.mjs",
    "radar:publish": "node scripts/publish-radar-to-github.mjs",
    "radar:publish:check": "node scripts/publish-radar-to-github.mjs --check-only",
    "market:snapshot": "node scripts/generate-cross-market-snapshot.mjs",
    "market:demo": "node scripts/generate-cross-market-snapshot.mjs --demo",
    "market:publish": "node scripts/publish-cross-market-to-github.mjs",
    "market:publish:check": "node scripts/publish-cross-market-to-github.mjs --check-only",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@cloudflare/workers-types": "5.20260815.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  },
  "type": "module"
}
